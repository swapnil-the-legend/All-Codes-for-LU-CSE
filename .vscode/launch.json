{
    "version": "0.2.0",
    "configurations": [
        {
            //C/C++
            "name": "Debug C/C++ with GCC 16.2.0",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "preLaunchTask": "Build C++23 with GCC 16.2.0"
        },
        {
            //Python
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            //Java
            "type": "java",
            "name": "Launch Java",
            "request": "launch",
            "mainClass": "Main"
        }
    ]
}
