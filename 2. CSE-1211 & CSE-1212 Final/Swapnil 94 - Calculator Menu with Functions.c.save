#include<stdio.h>
void choice()
{
    printf("1. Addition\n");
    printf("2. Subtraction\n");
    printf("3. Multiplication\n");
    printf("4. Division\n");
    printf("5. Exit\n");
    printf("")
}

int addition()
{
    printf("Enter two numbers: ");
    int a1, b1;
    scanf("%d %d", &a1, &b1);
    int add = a1 + b1;
    printf("Result: %d\n\n", add);
}

int subtraction()
{
    printf("Enter two numbers: ");
    int a2, b2;
    scanf("%d %d", &a2, &b2);
    int sub = a2 - b2;
    printf("Result: %d\n\n", sub);
}

int multiplication()
{
    printf("Enter two numbers: ");
    int a3, b3;
    scanf("%d %d", &a3, &b3);
    int multi = a3 * b3;
    printf("Result: %d\n\n", multi);
}

int division()
{
    printf("Enter two numbers: ");
    float a4, b4;
    scanf("%d %d", &a4, &b4);
    if(b4==0)
        printf("Cannot be divided by zero\n\n");
    else
    {
        float div = a4 / b4;
        printf("Result: %f\n\n", div);
    }
}

int main()
{
    while(1)
    {
        choice();
        printf("\n");
        int choice;
        scanf("%d", &choice);
        switch(choice)
        {
        case 1:
            addition();
            break;

        case 2:
            subtraction();
            break;

        case 3:
            multiplication();
            break;

        case 4:
            division();
            break;

        case 5:
            return 0;
            break;

        default:
            printf("Invalid choice\n\n");
        }
    }
    return 0;
}

